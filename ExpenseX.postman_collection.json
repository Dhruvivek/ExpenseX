{
  "info": {
    "name": "ExpenseX",
    "description": "A secure REST API for tracking personal expenses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://expensex-tutr.onrender.com/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('token', res.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new user. Automatically saves the token to collection variables."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('token', res.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with existing credentials. Automatically saves the token to collection variables."
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lunch\",\n  \"amount\": 150,\n  \"category\": \"Food\",\n  \"description\": \"Lunch with friends\",\n  \"date\": \"2024-01-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/expense/create",
              "host": ["{{base_url}}"],
              "path": ["expense", "create"]
            },
            "description": "Create a new expense. Valid categories: Food, Transport, Shopping, Health, Entertainment, Education, Rent, Other."
          }
        },
        {
          "name": "Get All Expenses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/expense/getAll?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["expense", "getAll"],
              "query": [
                {
                  "key": "category",
                  "value": "Food",
                  "disabled": true,
                  "description": "Filter by category"
                },
                {
                  "key": "from",
                  "value": "2024-01-01",
                  "disabled": true,
                  "description": "Start date (YYYY-MM-DD)"
                },
                {
                  "key": "to",
                  "value": "2024-12-31",
                  "disabled": true,
                  "description": "End date (YYYY-MM-DD)"
                },
                {
                  "key": "sort",
                  "value": "date",
                  "disabled": true,
                  "description": "Sort by field (date or amount)"
                },
                {
                  "key": "order",
                  "value": "desc",
                  "disabled": true,
                  "description": "asc or desc"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Results per page"
                }
              ]
            },
            "description": "Get all expenses with optional filters, sorting and pagination."
          }
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dinner\",\n  \"amount\": 200,\n  \"category\": \"Food\",\n  \"description\": \"Dinner with family\",\n  \"date\": \"2024-01-15\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/expense/update/:id",
              "host": ["{{base_url}}"],
              "path": ["expense", "update", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "expense_id_here",
                  "description": "MongoDB ObjectId of the expense"
                }
              ]
            },
            "description": "Update an existing expense by ID. Only the owner can update."
          }
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/expense/delete/:id",
              "host": ["{{base_url}}"],
              "path": ["expense", "delete", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "expense_id_here",
                  "description": "MongoDB ObjectId of the expense"
                }
              ]
            },
            "description": "Delete an expense by ID. Only the owner can delete."
          }
        },
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/expense/summary",
              "host": ["{{base_url}}"],
              "path": ["expense", "summary"]
            },
            "description": "Get spending summary including total spent, category breakdown and monthly totals."
          }
        }
      ]
    }
  ]
}
